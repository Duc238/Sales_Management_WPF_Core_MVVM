<UserControl x:Class="SalesManagement_WPF_Core.DucUserControl.ucListObject"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SalesManagement_WPF_Core.DucUserControl"
             mc:Ignorable="d" 
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ViewModel="clr-namespace:SalesManagement_WPF_Core.ViewModel">
    <UserControl.DataContext>
        <ViewModel:ObjectViewModel></ViewModel:ObjectViewModel>
    </UserControl.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- KHU VỰC NHẬP/SỬA SẢN PHẨM -->
        <materialDesign:Card Grid.Row="1" Margin="0 0 0 10">
            <WrapPanel Margin="5">
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="5 5 15 5" materialDesign:HintAssist.Hint="Tên sản phẩm" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                <ComboBox Margin="5 5 15 5" DisplayMemberPath="DisplayName" ItemsSource="{Binding Unit}" SelectedItem="{Binding SelectedUnit, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Đơn vị đo" IsEditable="True" Style="{StaticResource MaterialDesignFloatingHintComboBox}"></ComboBox>
                <ComboBox Margin="5 5 15 5" DisplayMemberPath="DisplayName" ItemsSource="{Binding Suplier}" SelectedItem="{Binding SelectedSuplier, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Nhà cung cấp" IsEditable="True" Style="{StaticResource MaterialDesignFloatingHintComboBox}"></ComboBox>
                <TextBox Text="{Binding BarCode, UpdateSourceTrigger=PropertyChanged}" Margin="5 5 15 5" materialDesign:HintAssist.Hint="Bar code" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                <TextBox Text="{Binding InputPrice, UpdateSourceTrigger=PropertyChanged}" Margin="5 5 15 5" materialDesign:HintAssist.Hint="Giá nhập" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                <materialDesign:NumericUpDown HorizontalAlignment="Center" VerticalAlignment="Bottom" materialDesign:HintAssist.Hint="%" Value="{Binding PercentPrice, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" Margin="5 5 15 5"></materialDesign:NumericUpDown>
                <TextBox IsReadOnly="True" Text="{Binding OutputPrice, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" Margin="5 5 15 5" materialDesign:HintAssist.Hint="Giá bán" Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                <Button Margin="5" Content="Thêm sản phẩm" Command="{Binding AddCommand}"></Button>
                <Button Margin="5" Content="Sửa sản phẩm" Command="{Binding EditCommand}"></Button>
                <Button Margin="5" Content="Xóa sản phẩm" Command="{Binding DeleteCommand}"></Button>
                <Button Margin="5" Content="Xuất Excel" Command="{Binding ExportExcelCommand}"></Button>
            </WrapPanel>
        </materialDesign:Card>

        <!-- KHU VỰC QUÉT MÃ VẠCH & BÁN HÀNG -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <!-- Cột trái: Danh sách tất cả sản phẩm trong kho -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <TextBox Text="{Binding SearchProduct, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tìm kiếm sản phẩm" Style="{StaticResource MaterialDesignFloatingHintTextBox}"></TextBox>
                <materialDesign:Card Grid.Row="1" MaxHeight="500" Margin="0 0 5 0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="DANH SÁCH SẢN PHẨM" FontWeight="Bold" Margin="10" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <ListView ItemsSource="{Binding FilterView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding SelectedItem}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Tên sản phẩm" DisplayMemberBinding="{Binding DisplayName}"></GridViewColumn>
                                    <GridViewColumn Header="BarCode" DisplayMemberBinding="{Binding BarCode}"></GridViewColumn>
                                    <GridViewColumn Header="Giá nhập" DisplayMemberBinding="{Binding InputPrice}"></GridViewColumn>
                                    <GridViewColumn Header="%" DisplayMemberBinding="{Binding PercentPrice}"></GridViewColumn>
                                    <GridViewColumn Header="Giá bán" DisplayMemberBinding="{Binding OutputPrice, StringFormat={}{0:N0}}"></GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Cột phải: Ô Quét Mã Vạch, Nút Chọn Nhanh & Giỏ hàng -->
            <materialDesign:Card Grid.Column="1" Margin="5 0 0 0">
                <DockPanel Margin="10">
                    <!-- 1. Ô Quét Mã Vạch -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 5">
                        <materialDesign:PackIcon Kind="BarcodeScan" Width="30" Height="30" VerticalAlignment="Center" Margin="0 0 10 0"/>
                        <TextBox x:Name="txtBarCode"
                                 Width="250" 
                                 materialDesign:HintAssist.Hint="Quét mã vạch tại đây..." 
                                 Text="{Binding ScannedBarCode, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 FontSize="14" FontWeight="Bold">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ScanBarCodeCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>

                    <!-- 2. DANH SÁCH NÚT CHỌN NHANH (Sản phẩm không mã vạch) -->
                    <materialDesign:Card DockPanel.Dock="Top" Margin="0 5 0 10" Padding="5" Background="#F5F5F5" MaxHeight="130">
                        <DockPanel>
                            <TextBlock Text="MÓN BÁN LẺ (KHÔNG MÃ VẠCH)" DockPanel.Dock="Top" FontSize="11" FontWeight="Bold" Foreground="#1565C0" Margin="4 0 0 4"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding QuickPickProducts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Margin="2" Padding="2" Height="45"
                                                    Command="{Binding DataContext.AddQuickProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding OutputPrice, StringFormat={}{0:N0} đ}" FontSize="10" Foreground="#2E7D32"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </materialDesign:Card>

                    <!-- 3. Khối Tính Tiền & Thanh Toán (Góc dưới cùng) -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0 10 0 0">
                        <Border Background="#FFF3E0" Padding="12" CornerRadius="5">
                            <StackPanel Orientation="Vertical">
                                <!-- TỔNG TIỀN -->
                                <Grid Margin="0 0 0 5">
                                    <TextBlock Text="TỔNG TIỀN:" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GrandTotal, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0} VNĐ}" 
                                               FontSize="18" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- TIỀN KHÁCH ĐƯA -->
                                <Grid Margin="0 5">
                                    <TextBlock Text="Tiền khách đưa:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding CustomerPayment, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}" 
                                             Width="160" FontSize="15" FontWeight="Bold"
                                             HorizontalAlignment="Right" HorizontalContentAlignment="Right"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                             materialDesign:HintAssist.Hint="0 VNĐ"/>
                                </Grid>

                                <!-- TIỀN THỐI LẠI -->
                                <Grid Margin="0 5 0 0">
                                    <TextBlock Text="Tiền thối lại:" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ChangeMoney, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0} VNĐ}" 
                                               FontSize="16" FontWeight="Bold" Foreground="#388E3C" 
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Nút In Hóa Đơn -->
                        <Button Content="IN HÓA ĐƠN" Command="{Binding PrintInvoiceCommand}" Margin="0 10 0 0" Height="40" Background="#2196F3" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- 4. Bảng các món đã quét / đã chọn -->
                    <materialDesign:Card MaxHeight="250" Margin="0 0 5 0">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Bottom" 
                                    Command="{Binding DeleteProductOrderedCommand}" 
                                    Content="Xóa các sản phẩm đã thanh toán" 
                                    Style="{StaticResource MaterialDesignRaisedLightButton}" 
                                    Margin="8"/>

                            <ListView ItemsSource="{Binding CartList, UpdateSourceTrigger=PropertyChanged}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Tên sản phẩm" DisplayMemberBinding="{Binding Product.DisplayName}" Width="140"/>
                                        <GridViewColumn Header="Giá bán" DisplayMemberBinding="{Binding Product.OutputPrice, StringFormat={}{0:N0}}" Width="85"/>
                                        <GridViewColumn Header="Số lượng" DisplayMemberBinding="{Binding Quantity}" Width="65"/>
                                        <GridViewColumn Header="Thành tiền" DisplayMemberBinding="{Binding TotalPrice, StringFormat={}{0:N0}}" Width="95"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </materialDesign:Card>
                </DockPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>